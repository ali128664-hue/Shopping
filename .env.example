# Copy this file to .env and fill in your values. .env is git-ignored — never commit it.
PORT=3000
ADMIN_PASSWORD=change-me
# Long random text used to sign admin logins
SESSION_SECRET=
# Google Gemini key for the AI fitting room (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-image
# Bank transfer details shown to customers
BANK_NAME=Your Bank Name
BANK_TITLE=STORE
BANK_IBAN=PK00 XXXX 0000 0000 0000 0000
